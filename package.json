{
  "name": "@designliquido/delegua-criptografia",
  "version": "0.3.3",
  "description": "Biblioteca de criptografia para Delégua e JavaScript com nomes de métodos em português",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "empacotar": "yarn rimraf ./dist && tsc && yarn copyfiles -V ./README.md ./dist && yarn copyfiles -V ./package.json ./dist",
    "lint": "eslint fontes/**/*.ts",
    "publicar-npm": "npm publish ./dist --access public",
    "testes-unitarios": "yarn jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesignLiquido/delegua-criptografia.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "delegua",
    "criptografia",
    "crypto",
    "hash",
    "encryption",
    "português",
    "portuguese"
  ],
  "author": "Design Líquido",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DesignLiquido/delegua-criptografia/issues"
  },
  "homepage": "https://github.com/DesignLiquido/delegua-criptografia#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "release-it": "^19.0.6",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
